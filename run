#!/bin/bash
set -e

if [ "${1:-}" = "clean" ]; then
    rm -rf build vulkan
    exit 0
fi

mkdir -p build

compile_shader() {
    local src=$1
    local out=$2
    if [ ! -f "$out" ] || [ "$src" -nt "$out" ]; then
        echo "compiling shader: $src"
        glslc "$src" -o "$out"
    fi
}

compile_shader assets/vertexShader.vert build/vert.spv
compile_shader assets/fragmentShader.frag build/frag.spv

CXXFLAGS=(
  -std=c++17
  -Iexternal
  -Iexternal/imgui
  -DIMGUI_IMPL_API='extern "C"'
  -DCIMGUI_USE_GLFW
  -DCIMGUI_USE_VULKAN
)

CPP_SRCS=(
  external/cimgui.cpp
  external/cimgui_impl.cpp
  external/imgui/imgui.cpp
  external/imgui/imgui_draw.cpp
  external/imgui/imgui_widgets.cpp
  external/imgui/imgui_tables.cpp
  external/imgui/imgui_demo.cpp
  external/imgui_impl_glfw.cpp
  external/imgui_impl_vulkan.cpp
  external/stb_image.cpp
)

for src in "${CPP_SRCS[@]}"; do
    out="build/$(basename "${src%.cpp}.o")"
    if [ ! -f "$out" ] || [ "$src" -nt "$out" ]; then
        echo "compiling C++: $src"
        g++ "${CXXFLAGS[@]}" -c "$src" -o "$out"
    fi
done

C_SRCS=(
  external/tinyobj_loader_c.c
  external/hash.c
)

for src in "${C_SRCS[@]}"; do
    out="build/$(basename "${src%.c}.o")"
    if [ ! -f "$out" ] || [ "$src" -nt "$out" ]; then
        echo "compiling C: $src"
        g++ "${CXXFLAGS[@]}" -c "$src" -o "$out"
    fi
done

MAIN_OUT=build/main.o
if [ ! -f "$MAIN_OUT" ] || [ main.c -nt "$MAIN_OUT" ] || [ external/ui.h -nt "$MAIN_OUT" ] || [ external/state.h -nt "$MAIN_OUT" ]; then
    echo "compiling main.c"
    gcc -std=c17 -g -O3 -D_POSIX_C_SOURCE=199309L -Iexternal -Iexternal/imgui -c main.c -o "$MAIN_OUT"
fi

objects=(build/*.o)
needs_link=0

if [ ! -f vulkan ]; then
    needs_link=1
else
    for obj in "${objects[@]}"; do
        if [ "$obj" -nt vulkan ]; then
            needs_link=1
            break
        fi
    done
fi

if [ "$needs_link" -eq 1 ]; then
    echo "linking"
    g++ "${objects[@]}" -lX11 -lglfw -lvulkan -ldl -lrt -lpthread -o vulkan
fi

./vulkan
